{
  "manifest_version": 3,
  "name": "Mousse",
  "version": "1.0",

  "description": "Adds a red border to all webpages matching mozilla.org.",

  "action": {
      "default_title": "Start mousse",
      "default_popup": "popup.html"
  },
  "permissions": ["scripting", "activeTab"],
  "web_accessible_resources": [
    {
      "resources": ["game.wasm"],
      "matches": ["<all_urls>"]
    }
  ]
}
